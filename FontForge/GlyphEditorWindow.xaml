<Window x:Class="FontForge.GlyphEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование символа"
        Height="680"
        Width="1040"
        MinHeight="680"
        MinWidth="1040"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Logo.png"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <SolidColorBrush x:Key="EditorPaperBrush" Color="#F3F4EF"/>
        <SolidColorBrush x:Key="EditorPaperBorderBrush" Color="#C9D0C7"/>

        <Style x:Key="EditorSideCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsBlock" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource AppSecondaryButton}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource AppDangerButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource AppSecondaryButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <Style x:Key="AppCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Box"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="6"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center">

                                <Path x:Name="CheckMark"
                                      Data="M 4 10 L 8 14 L 16 5"
                                      Stroke="{DynamicResource ButtonTextBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Outer"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center">

                                <Ellipse x:Name="Inner"
                                         Width="10"
                                         Height="10"
                                         Fill="{DynamicResource ButtonBackgroundBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrettySlider" TargetType="Slider">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="34" SnapsToDevicePixels="True">

                            <Border x:Name="TrackBg"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    Background="{DynamicResource BorderBrush}"
                                    Opacity="0.85"/>

                            <Border x:Name="TrackFill"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left"
                                    Width="0"/>

                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  IsHitTestVisible="False"/>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  IsHitTestVisible="False"/>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                           Width="20"
                                           Height="20"
                                           Cursor="Hand"
                                           Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="Glow"
                                                             Width="34"
                                                             Height="34"
                                                             Fill="{DynamicResource AccentBrush}"
                                                             Opacity="0"/>

                                                    <Ellipse x:Name="Knob"
                                                             Width="20"
                                                             Height="20"
                                                             Fill="{DynamicResource SurfaceBrush}"
                                                             Stroke="{DynamicResource AccentBrush}"
                                                             StrokeThickness="2"/>
                                                </Grid>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glow" Property="Opacity" Value="0.16"/>
                                                    </Trigger>

                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Glow" Property="Opacity" Value="0.25"/>
                                                        <Setter TargetName="Knob" Property="StrokeThickness" Value="3"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>

                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Border Style="{StaticResource EditorSideCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="HeaderText"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Text="Рисуйте букву, стирайте лишнее или корректируйте форму по точкам."
                               Margin="0,8,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <Border Style="{StaticResource SettingsBlock}">
                            <StackPanel>
                                <TextBlock Text="Подложка и соединение"
                                           Style="{StaticResource SectionTitle}"/>

                                <CheckBox x:Name="ShowGuideCheck"
                                          Style="{StaticResource AppCheckBox}"
                                          Content="Показывать букву внутри"
                                          IsChecked="True"
                                          Checked="ShowGuideCheck_Changed"
                                          Unchecked="ShowGuideCheck_Changed"/>

                                <CheckBox x:Name="ShowConnectGuidesCheck"
                                          Style="{StaticResource AppCheckBox}"
                                          Content="Показывать границы соединения"
                                          IsChecked="True"
                                          Margin="0,10,0,0"
                                          Checked="ShowConnectGuidesCheck_Changed"
                                          Unchecked="ShowConnectGuidesCheck_Changed"/>

                                <TextBlock Text="Левая линия — вход буквы, правая линия — выход к следующей букве."
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsBlock}">
                            <StackPanel>
                                <TextBlock Text="Режим работы"
                                           Style="{StaticResource SectionTitle}"/>

                                <RadioButton x:Name="ModeDrawRadio"
                                             Style="{StaticResource AppRadioButton}"
                                             Content="Рисование"
                                             IsChecked="True"
                                             Checked="ModeRadio_Checked"
                                             Margin="0,0,0,10"/>

                                <RadioButton x:Name="ModeEraseRadio"
                                             Style="{StaticResource AppRadioButton}"
                                             Content="Ластик"
                                             Checked="ModeRadio_Checked"
                                             Margin="0,0,0,10"/>

                                <RadioButton x:Name="ModeEditRadio"
                                             Style="{StaticResource AppRadioButton}"
                                             Content="Редактирование линий"
                                             Checked="ModeRadio_Checked"
                                             Margin="0,0,0,10"/>

                                <RadioButton x:Name="ModeCurveRadio"
                                             Style="{StaticResource AppRadioButton}"
                                             Content="Коррекция кривой"
                                             Checked="ModeRadio_Checked"/>

                                <TextBlock Text="В режиме коррекции нажмите на линию и двигайте опорные точки."
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsBlock}">
                            <StackPanel>
                                <TextBlock Text="Тип кисти"
                                           Style="{StaticResource SectionTitle}"/>

                                <RadioButton x:Name="BrushNormalRadio"
                                             Style="{StaticResource AppRadioButton}"
                                             Content="Обычная круглая кисть"
                                             IsChecked="True"
                                             Checked="BrushTypeRadio_Checked"
                                             Margin="0,0,0,10"/>

                                <RadioButton x:Name="BrushCalligraphyRadio"
                                             Style="{StaticResource AppRadioButton}"
                                             Content="Каллиграфическая кисть"
                                             Checked="BrushTypeRadio_Checked"/>

                                <TextBlock Text="Каллиграфическая кисть пишет как перо: линия получается с наклоном и разной толщиной."
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsBlock}">
                            <StackPanel>
                                <TextBlock Text="Действия"
                                           Style="{StaticResource SectionTitle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Отменить"
                                            Style="{StaticResource SmallButton}"
                                            Margin="0,0,6,0"
                                            Click="Undo_Click"/>

                                    <Button Grid.Column="1"
                                            Content="Очистить"
                                            Style="{StaticResource DangerButton}"
                                            Margin="6,0,0,0"
                                            Click="Clear_Click"/>
                                </Grid>

                                <Button x:Name="DeleteSelectedButton"
                                        Content="Удалить выделенное"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource DangerButton}"
                                        Click="DeleteSelected_Click"
                                        Visibility="Collapsed"/>

                                <Button x:Name="DeleteCurveButton"
                                        Content="Удалить выбранную кривую"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource DangerButton}"
                                        Click="DeleteCurve_Click"
                                        Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsBlock}">
                            <StackPanel>
                                <TextBlock Text="Параметры кисти"
                                           Style="{StaticResource SectionTitle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Размер кисти"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="13"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ElementName=BrushSizeSlider, Path=Value, StringFormat={}{0:0}px}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="13"/>
                                </Grid>

                                <Slider x:Name="BrushSizeSlider"
                                        Style="{StaticResource PrettySlider}"
                                        Minimum="2"
                                        Maximum="36"
                                        Value="12"
                                        ValueChanged="BrushSettings_Changed"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Наклон пера"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="13"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ElementName=CalligraphyAngleSlider, Path=Value, StringFormat={}{0:0}°}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="13"/>
                                </Grid>

                                <Slider x:Name="CalligraphyAngleSlider"
                                        Style="{StaticResource PrettySlider}"
                                        Minimum="-70"
                                        Maximum="70"
                                        Value="-35"
                                        TickFrequency="1"
                                        ValueChanged="BrushSettings_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsBlock}">
                            <StackPanel>
                                <TextBlock Text="Параметры ластика"
                                           Style="{StaticResource SectionTitle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Размер ластика"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="13"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ElementName=EraserSizeSlider, Path=Value, StringFormat={}{0:0}px}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="13"/>
                                </Grid>

                                <Slider x:Name="EraserSizeSlider"
                                        Style="{StaticResource PrettySlider}"
                                        Minimum="8"
                                        Maximum="80"
                                        Value="28"
                                        ValueChanged="EraserSettings_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsBlock}">
                            <StackPanel>
                                <TextBlock Text="Коррекция кривой"
                                           Style="{StaticResource SectionTitle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Количество точек"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="13"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ElementName=CurvePointDensitySlider, Path=Value, StringFormat={}{0:0}}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="13"/>
                                </Grid>

                                <Slider x:Name="CurvePointDensitySlider"
                                        Style="{StaticResource PrettySlider}"
                                        Minimum="6"
                                        Maximum="36"
                                        Value="18"
                                        TickFrequency="1"
                                        ValueChanged="CurvePointDensity_Changed"/>

                                <TextBlock Text="Чем больше точек, тем точнее можно менять форму линии."
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2"
                            Margin="0,18,0,0">

                    <Button Content="Сохранить символ"
                            Style="{StaticResource PrimaryButton}"
                            Click="Save_Click"/>

                    <Button Content="← Назад"
                            Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Правая область -->
        <Border Grid.Column="1"
                Margin="20,0,0,0"
                CornerRadius="26"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource MutedBorderBrush}"
                BorderThickness="1"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="4,0,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Поле рисования"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="Рисуйте, стирайте или корректируйте форму линии через опорные точки."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">

                        <Border CornerRadius="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource MutedBorderBrush}"
                                BorderThickness="1"
                                Padding="10,6"
                                Margin="0,0,8,0">
                            <TextBlock Text="левая = вход"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Border>

                        <Border CornerRadius="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource MutedBorderBrush}"
                                BorderThickness="1"
                                Padding="10,6">
                            <TextBlock Text="правая = выход"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        CornerRadius="22"
                        Background="{StaticResource EditorPaperBrush}"
                        BorderBrush="{StaticResource EditorPaperBorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16"
                                          ShadowDepth="0"
                                          Opacity="0.10"
                                          Color="#000000"/>
                    </Border.Effect>

                    <Grid x:Name="WorkGrid"
                          ClipToBounds="True">

                        <Canvas x:Name="GuideLinesCanvas"
                                IsHitTestVisible="False"/>

                        <Viewbox x:Name="GuideViewbox"
                                 IsHitTestVisible="False"
                                 Stretch="Uniform"
                                 Opacity="0.14">
                            <TextBlock x:Name="GuideLetterText"
                                       Text="A"
                                       FontSize="600"
                                       FontWeight="Bold"
                                       Foreground="#303030"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Viewbox>

                        <Image x:Name="ExistingGlyphImage"
                               Stretch="Uniform"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"
                               Opacity="1"/>

                        <InkCanvas x:Name="Ink"
                                   Background="Transparent"
                                   SelectionChanged="Ink_SelectionChanged"
                                   StrokeCollected="Ink_StrokeCollected"
                                   StrokeErasing="Ink_StrokeErasing"
                                   PreviewMouseDown="Ink_PreviewMouseDown_ForceMode"
                                   PreviewStylusDown="Ink_PreviewStylusDown_ForceMode"/>

                        <Canvas x:Name="CurveEditCanvas"
                                Background="Transparent"
                                Visibility="Collapsed"
                                MouseLeftButtonDown="CurveEditCanvas_MouseLeftButtonDown"
                                MouseMove="CurveEditCanvas_MouseMove"
                                MouseLeftButtonUp="CurveEditCanvas_MouseLeftButtonUp"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>