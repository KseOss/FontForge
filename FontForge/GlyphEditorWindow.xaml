<Window x:Class="FontForge.GlyphEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование символа"
        Height="640" Width="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Logo.png"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="#0D000000"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="22" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#0A000000"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Background" Value="#26DD4B4B"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <!-- ===== Красивый Slider (Round) ===== -->
        <Style x:Key="PrettySlider" TargetType="Slider">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Foreground" Value="#2D8CFF"/>
            <Setter Property="Background" Value="#1A000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="34" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Track background -->
                            <Border x:Name="TrackBg"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Background}"/>

                            <!-- Filled part -->
                            <Border x:Name="TrackFill"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"
                                    Width="0"/>

                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  IsHitTestVisible="False"/>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  IsHitTestVisible="False"/>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                           Width="18"
                                           Height="18"
                                           Cursor="Hand"
                                           Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="Knob"
                                                             Fill="White"
                                                             Stroke="#33000000"
                                                             StrokeThickness="1"/>
                                                    <Ellipse x:Name="KnobGlow"
                                                             Opacity="0"
                                                             Fill="{TemplateBinding Foreground}"
                                                             Width="36"
                                                             Height="36"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Stroke" Value="#552D8CFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Knob" Property="Stroke" Value="#882D8CFF"/>
                                                        <Setter TargetName="KnobGlow" Property="Opacity" Value="0.12"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>

                        </Grid>

                        <!-- Fill width binding -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TrackBg" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="TrackFill" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="HeaderText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>

                <CheckBox x:Name="ShowGuideCheck"
                          Margin="0,14,0,0"
                          Foreground="{DynamicResource SecondaryTextBrush}"
                          Content="Написать букву внутри"
                          IsChecked="True"
                          Checked="ShowGuideCheck_Changed"
                          Unchecked="ShowGuideCheck_Changed"/>

                <TextBlock Text="Режим" Style="{StaticResource SectionTitle}"/>

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModeDrawRadio"
                                 Content="Рисование"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 IsChecked="True"
                                 Checked="ModeRadio_Checked"
                                 Margin="0,0,16,0"/>

                    <RadioButton x:Name="ModeEditRadio"
                                 Content="Редактирование"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 Checked="ModeRadio_Checked"/>
                </StackPanel>

                <TextBlock Text="Действия" Style="{StaticResource SectionTitle}"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Отменить"
                            Width="120"
                            Style="{StaticResource SmallButton}"
                            Click="Undo_Click"/>
                    <Button Content="Удалить всё"
                            Width="120"
                            Margin="10,0,0,0"
                            Style="{StaticResource DangerButton}"
                            Click="Clear_Click"/>
                </StackPanel>

                <Button x:Name="DeleteSelectedButton"
                        Content="Удалить выделенное"
                        Margin="0,10,0,0"
                        Style="{StaticResource DangerButton}"
                        Click="DeleteSelected_Click"
                        Visibility="Collapsed"/>

                <TextBlock Text="Параметры кисти" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Размер кисти" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <Slider x:Name="BrushSizeSlider"
                        Style="{StaticResource PrettySlider}"
                        Minimum="2" Maximum="36" Value="12"
                        ValueChanged="BrushSettings_Changed"/>

                <Button Content="Сохранить символ"
                        Margin="0,18,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click"/>

                <Button Content="Отмена"
                        Margin="0,10,0,0"
                        Height="44"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Border>

        <!-- Right: workspace -->
        <Border Grid.Column="1"
                Margin="18,0,0,0"
                CornerRadius="18"
                Background="White"
                BorderBrush="#22000000"
                BorderThickness="1">

            <Grid x:Name="WorkGrid" ClipToBounds="True">
                <Canvas x:Name="GuideLinesCanvas" IsHitTestVisible="False"/>

                <Viewbox x:Name="GuideViewbox"
                         IsHitTestVisible="False"
                         Stretch="Uniform"
                         Opacity="0.20">
                    <TextBlock x:Name="GuideLetterText"
                               Text="A"
                               FontSize="600"
                               FontWeight="Bold"
                               Foreground="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Viewbox>

                <InkCanvas x:Name="Ink"
                           Background="Transparent"
                           SelectionChanged="Ink_SelectionChanged"
                           StrokeCollected="Ink_StrokeCollected"
                           PreviewMouseDown="Ink_PreviewMouseDown_ForceMode"
                           PreviewStylusDown="Ink_PreviewStylusDown_ForceMode"/>
            </Grid>
        </Border>
    </Grid>
</Window>
