<Window x:Class="FontForge.FontsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои шрифты"
        Height="560"
        Width="940"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Logo.png"
        Opacity="0"
        Loaded="Window_Loaded">

    <Window.Resources>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="230"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource AppSecondaryButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="118"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="19"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FontCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="EmptyStateIconBox" TargetType="Border">
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PillTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource MutedBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="6"
                                    HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True"
                                          Margin="0"
                                          Background="Transparent"/>
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              Margin="0,12,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Pill"
                                CornerRadius="14"
                                Padding="18,8"
                                Margin="4,2"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя строка навигации -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="← Назад"
                    Style="{StaticResource HeaderButton}"
                    HorizontalAlignment="Left"
                    Click="BackToMain_Click"/>

            <Button Grid.Column="2"
                    Content="⚙ Настройки"
                    Style="{StaticResource HeaderButton}"
                    HorizontalAlignment="Right"
                    Click="OpenSettings_Click"/>
        </Grid>

        <!-- Заголовок -->
        <StackPanel Grid.Row="1"
                    Margin="0,18,0,0">

            <TextBlock Text="Мои шрифты"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>

            <TextBlock Text="Управление созданными шрифтами и корзиной"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <!-- Контент -->
        <Grid Grid.Row="2"
              Margin="0,22,0,0">

            <TabControl Style="{StaticResource PillTabControlStyle}"
                        ItemContainerStyle="{StaticResource PillTabItemStyle}">

                <!-- Созданные -->
                <TabItem Header="Созданные шрифты">
                    <Grid>

                        <!-- Пустое состояние -->
                        <Grid x:Name="EmptyActivePanel"
                              Visibility="Collapsed">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="520"
                                        Margin="0,-30,0,0">

                                <Border Style="{StaticResource EmptyStateIconBox}">
                                    <TextBlock Text="A"
                                               FontSize="44"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="У вас пока нет шрифтов"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,24,0,6"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Создайте свой первый шрифт на основе собственного почерка"
                                           FontSize="14"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,26"/>

                                <Button Content="Создать новый шрифт"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="240"
                                        HorizontalAlignment="Center"
                                        Click="CreateNewFont_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Список шрифтов -->
                        <Grid x:Name="ActiveListPanel"
                              Visibility="Collapsed">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0,0,4,0">

                                <ItemsControl ItemsSource="{Binding ActiveFonts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FontCard}">

                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  CommandParameter="{Binding}"
                                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=OpenEditorCommand}"/>
                                                </Border.InputBindings>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>

                                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Создан: {0:dd.MM.yyyy HH:mm}'}"
                                                                   Margin="0,6,0,0"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource IconButton}"
                                                            Content="✏️"
                                                            ToolTip="Редактировать"
                                                            Click="EditFont_Click"
                                                            Margin="0,0,6,0"/>

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource IconButton}"
                                                            Content="📝"
                                                            ToolTip="Переименовать"
                                                            Click="RenameFont_Click"
                                                            Margin="0,0,6,0"/>

                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource IconButton}"
                                                            Content="🗑️"
                                                            ToolTip="Переместить в корзину"
                                                            Click="MoveToTrash_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="1"
                                    Padding="0,12,0,0"
                                    Background="Transparent">

                                <Button Content="Создать новый шрифт"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="240"
                                        HorizontalAlignment="Center"
                                        Click="CreateNewFont_Click"/>
                            </Border>
                        </Grid>

                    </Grid>
                </TabItem>

                <!-- Корзина -->
                <TabItem Header="Корзина">
                    <Grid>

                        <!-- Пустая корзина -->
                        <Grid x:Name="EmptyTrashPanel"
                              Visibility="Collapsed">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="520"
                                        Margin="0,-30,0,0">

                                <Border Style="{StaticResource EmptyStateIconBox}">
                                    <TextBlock Text="&#xE74D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="42"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Корзина пуста"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,24,0,6"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Удалённые шрифты будут появляться здесь."
                                           FontSize="14"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Список корзины -->
                        <Grid x:Name="TrashListPanel"
                              Visibility="Collapsed">

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Padding="0,0,4,0">

                                <ItemsControl ItemsSource="{Binding TrashFonts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FontCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>

                                                        <TextBlock Text="{Binding DeletedAt, StringFormat='В корзине с: {0:dd.MM.yyyy HH:mm}'}"
                                                                   Margin="0,6,0,0"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource IconButton}"
                                                            Content="↩"
                                                            ToolTip="Восстановить"
                                                            Click="Restore_Click"
                                                            Margin="0,0,6,0"/>

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource IconButton}"
                                                            Content="✕"
                                                            ToolTip="Удалить навсегда"
                                                            Click="DeleteForever_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>

        <Rectangle x:Name="FadeOverlay"
                   Grid.RowSpan="3"
                   Fill="{DynamicResource BackgroundBrush}"
                   Opacity="0"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>