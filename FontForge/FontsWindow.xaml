<Window x:Class="FontForge.FontsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои шрифты"
        Height="560"
        Width="940"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Logo.png"
        Opacity="0"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>

        <!-- ToggleSwitch темы -->
        <Style x:Key="ThemeToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">

                            <Border x:Name="Track"
                                    CornerRadius="17"
                                    Background="#D6D6D6"
                                    BorderBrush="#B8B8B8"
                                    BorderThickness="1"/>

                            <Border x:Name="Thumb"
                                    Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2">

                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Border.RenderTransform>

                                <TextBlock x:Name="IconText"
                                           Text="🌙"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="IconText" Property="Text" Value="🔆"/>

                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="36"
                                                             Duration="0:0:0.18"
                                                             AccelerationRatio="0.2"
                                                             DecelerationRatio="0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.18"
                                                             AccelerationRatio="0.2"
                                                             DecelerationRatio="0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#F3F3F3"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.55"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Основная кнопка -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="230"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="24"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Небольшая кнопка во вкладках -->
        <Style x:Key="SmallPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="138"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>


        <!-- Иконка-кнопка -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="19"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Карточка шрифта -->
        <Style x:Key="FontCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>


        <!-- Вкладки -->
        <Style x:Key="PillTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource MutedBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="6"
                                    HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True"
                                          Margin="0"
                                          Background="Transparent"/>
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              Margin="0,12,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="PillTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Pill"
                                CornerRadius="14"
                                Padding="16,8"
                                Margin="4,2"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Мои шрифты"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Text="Управление созданными шрифтами и корзиной"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <ToggleButton x:Name="ThemeToggleButton"
                          Grid.Column="1"
                          Style="{StaticResource ThemeToggleSwitchStyle}"
                          VerticalAlignment="Top"
                          Click="ThemeToggleButton_Click"/>
        </Grid>


        <!-- Content -->
        <Grid Grid.Row="1"
              Margin="0,22,0,0">

            <TabControl Style="{StaticResource PillTabControlStyle}"
                        ItemContainerStyle="{StaticResource PillTabItemStyle}">

                <!-- Созданные -->
                <TabItem Header="Созданные шрифты">
                    <Grid>

                        <!-- Empty -->
                        <Grid x:Name="EmptyActivePanel"
                              Visibility="Collapsed">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="460">

                                <TextBlock Text="🅰️"
                                           FontSize="64"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="У вас пока нет шрифтов"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,18,0,6"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Создайте свой первый шрифт на основе собственного почерка"
                                           FontSize="14"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,26"/>

                                <Button Content="Создать новый шрифт"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="240"
                                        HorizontalAlignment="Center"
                                        Click="CreateNewFont_Click"/>
                            </StackPanel>
                        </Grid>


                        <!-- List -->
                        <Grid x:Name="ActiveListPanel"
                              Visibility="Collapsed">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0,0,4,0">

                                <ItemsControl ItemsSource="{Binding ActiveFonts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FontCard}">

                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  CommandParameter="{Binding}"
                                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=OpenEditorCommand}"/>
                                                </Border.InputBindings>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>

                                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Создан: {0:dd.MM.yyyy HH:mm}'}"
                                                                   Margin="0,6,0,0"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource IconButton}"
                                                            Content="✏️"
                                                            ToolTip="Редактировать"
                                                            Click="EditFont_Click"
                                                            Margin="0,0,6,0"/>

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource IconButton}"
                                                            Content="📝"
                                                            ToolTip="Переименовать"
                                                            Click="RenameFont_Click"
                                                            Margin="0,0,6,0"/>

                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource IconButton}"
                                                            Content="🗑️"
                                                            ToolTip="Переместить в корзину"
                                                            Click="MoveToTrash_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="1"
                                    Padding="0,12,0,0"
                                    Background="Transparent">

                                <Button Content="Создать новый шрифт"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="240"
                                        HorizontalAlignment="Center"
                                        Click="CreateNewFont_Click"/>
                            </Border>
                        </Grid>

                    </Grid>
                </TabItem>


                <!-- Корзина -->
                <TabItem Header="Корзина">
                    <Grid>

                        <!-- Empty -->
                        <Grid x:Name="EmptyTrashPanel"
                              Visibility="Collapsed">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="440">

                                <TextBlock Text="🧺"
                                           FontSize="64"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Корзина пуста"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,18,0,6"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Удалённые шрифты будут появляться здесь."
                                           FontSize="14"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>


                        <!-- List -->
                        <Grid x:Name="TrashListPanel"
                              Visibility="Collapsed">

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Padding="0,0,4,0">

                                <ItemsControl ItemsSource="{Binding TrashFonts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FontCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>

                                                        <TextBlock Text="{Binding DeletedAt, StringFormat='В корзине с: {0:dd.MM.yyyy HH:mm}'}"
                                                                   Margin="0,6,0,0"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource IconButton}"
                                                            Content="↩"
                                                            ToolTip="Восстановить"
                                                            Click="Restore_Click"
                                                            Margin="0,0,6,0"/>

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource IconButton}"
                                                            Content="✕"
                                                            ToolTip="Удалить навсегда"
                                                            Click="DeleteForever_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>


        <Rectangle x:Name="FadeOverlay"
                   Grid.RowSpan="2"
                   Fill="{DynamicResource BackgroundBrush}"
                   Opacity="0"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>