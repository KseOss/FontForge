<Window x:Class="FontForge.FontsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои шрифты"
        Height="560" Width="940"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Untitled.png"
        Opacity="0"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>

        <!-- ToggleSwitch темы (как в MainWindow) -->
        <Style x:Key="ThemeToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="Track"
                                    CornerRadius="17"
                                    Background="#D6D6D6"
                                    BorderBrush="#B8B8B8"
                                    BorderThickness="1"/>
                            <Border x:Name="Thumb"
                                    Width="30" Height="30"
                                    CornerRadius="15"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Border.RenderTransform>
                                <TextBlock x:Name="IconText"
                                           Text="🌙"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2D8CFF"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#2D8CFF"/>
                                <Setter TargetName="IconText" Property="Text" Value="🔆"/>

                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="36"
                                                             Duration="0:0:0.18"
                                                             AccelerationRatio="0.2"
                                                             DecelerationRatio="0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.18"
                                                             AccelerationRatio="0.2"
                                                             DecelerationRatio="0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#F3F3F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Основная кнопка -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="23" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Иконка-кнопка -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка -->
        <Style x:Key="FontCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="#0D000000"/>
        </Style>

        <!-- ====== КРАСИВЫЕ ВКЛАДКИ (PILL TABS) ====== -->
        <Style x:Key="PillTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="#0D000000"
                                    CornerRadius="18"
                                    Padding="6"
                                    HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True"
                                          Margin="0"
                                          Background="Transparent"/>
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              Margin="0,12,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Pill"
                                CornerRadius="14"
                                Padding="14,8"
                                Margin="4,2"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Мои шрифты"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Управление созданными шрифтами и корзиной"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <ToggleButton x:Name="ThemeToggleButton"
                          Grid.Column="1"
                          Style="{StaticResource ThemeToggleSwitchStyle}"
                          VerticalAlignment="Top"
                          Click="ThemeToggleButton_Click"/>
        </Grid>

        <Grid Margin="0,74,0,0">

            <TabControl Style="{StaticResource PillTabControlStyle}"
                        ItemContainerStyle="{StaticResource PillTabItemStyle}">

                <!-- Созданные -->
                <TabItem Header="Созданные шрифты">
                    <Grid>

                        <!-- Empty -->
                        <Grid x:Name="EmptyActivePanel" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="440">
                                <TextBlock Text="🅰️" FontSize="64" HorizontalAlignment="Center"/>
                                <TextBlock Text="У вас пока нет шрифтов"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,18,0,6"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Создайте свой первый шрифт на основе собственного почерка"
                                           FontSize="14"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,26"/>
                                <Button Content="+ Создать новый шрифт"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="CreateNewFont_Click"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- List -->
                        <Grid x:Name="ActiveListPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ActiveFonts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FontCard}">
                                                <!-- Открытие редактора по клику на карточку -->
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  CommandParameter="{Binding}"
                                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=OpenEditorCommand}"/>
                                                </Border.InputBindings>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Создан: {0:dd.MM.yyyy HH:mm}'}"
                                                                   Margin="0,6,0,0"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </StackPanel>

                                                    <!-- РЕДАКТИРОВАТЬ -->
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource IconButton}"
                                                            Content="✏️"
                                                            ToolTip="Редактировать"
                                                            Click="EditFont_Click"
                                                            Margin="0,0,6,0"/>

                                                    <!-- ПЕРЕИМЕНОВАТЬ -->
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource IconButton}"
                                                            Content="📝"
                                                            ToolTip="Переименовать"
                                                            Click="RenameFont_Click"
                                                            Margin="0,0,6,0"/>

                                                    <!-- В КОРЗИНУ -->
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource IconButton}"
                                                            Content="🗑️"
                                                            ToolTip="Переместить в корзину"
                                                            Click="MoveToTrash_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Row="1"
                                    Content="Создать новый шрифт"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0"
                                    Click="CreateNewFont_Click"/>
                        </Grid>

                    </Grid>
                </TabItem>

                <!-- Корзина -->
                <TabItem Header="Корзина">
                    <Grid>

                        <!-- Empty -->
                        <Grid x:Name="EmptyTrashPanel" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="440">
                                <TextBlock Text="🧺" FontSize="64" HorizontalAlignment="Center"/>
                                <TextBlock Text="Корзина пуста"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,18,0,6"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Удалённые шрифты будут появляться здесь."
                                           FontSize="14"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- List -->
                        <Grid x:Name="TrashListPanel" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding TrashFonts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FontCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text="{Binding DeletedAt, StringFormat='В корзине с: {0:dd.MM.yyyy HH:mm}'}"
                                                                   Margin="0,6,0,0"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource IconButton}"
                                                            Content="↩"
                                                            ToolTip="Восстановить"
                                                            Click="Restore_Click"
                                                            Margin="0,0,6,0"/>

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource IconButton}"
                                                            Content="✕"
                                                            ToolTip="Удалить навсегда"
                                                            Click="DeleteForever_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- Overlay -->
        <Rectangle x:Name="FadeOverlay"
                   Fill="{DynamicResource BackgroundBrush}"
                   Opacity="0"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
