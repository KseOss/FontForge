<Window x:Class="FontForge.ThemeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки оформления"
        Width="820"
        Height="660"
        MinWidth="820"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Logo.png"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- Карточка настроек -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Кнопка предпросмотра -->
        <Style x:Key="PreviewButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="21"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Заголовок -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Настройки оформления"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>

            <TextBlock Text="Выберите тему, цветовую палитру, фон и стиль кнопок."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>


        <!-- Основная часть -->
        <Grid Grid.Row="1"
              Margin="0,22,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- Левая карточка: настройки -->
            <Border Grid.Column="0"
                    Style="{StaticResource SettingsCard}">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock Text="Тема"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <ComboBox x:Name="ThemeModeCombo"
                                  Style="{StaticResource AppComboBox}"
                                  Margin="0,8,0,0"
                                  SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="Светлая" Tag="Light"/>
                            <ComboBoxItem Content="Тёмная" Tag="Dark"/>
                        </ComboBox>


                        <TextBlock Text="Цветовая тема"
                                   Margin="0,18,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <ComboBox x:Name="AccentCombo"
                                  Style="{StaticResource AppComboBox}"
                                  Margin="0,8,0,0"
                                  SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="Серая" Tag="Neutral"/>
                            <ComboBoxItem Content="Голубая" Tag="Blue"/>
                            <ComboBoxItem Content="Зелёная" Tag="Green"/>
                            <ComboBoxItem Content="Фиолетовая" Tag="Purple"/>
                            <ComboBoxItem Content="Розовая" Tag="Rose"/>
                            <ComboBoxItem Content="Оранжевая" Tag="Orange"/>
                        </ComboBox>


                        <TextBlock Text="Фон окна"
                                   Margin="0,18,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <ComboBox x:Name="BackgroundCombo"
                                  Style="{StaticResource AppComboBox}"
                                  Margin="0,8,0,0"
                                  SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="Обычный цвет" Tag="Plain"/>
                            <ComboBoxItem Content="Мягкий градиент" Tag="SoftGradient"/>
                            <ComboBoxItem Content="Выраженный градиент" Tag="StrongGradient"/>
                        </ComboBox>


                        <TextBlock Text="Кнопки"
                                   Margin="0,18,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <ComboBox x:Name="ButtonStyleCombo"
                                  Style="{StaticResource AppComboBox}"
                                  Margin="0,8,0,0"
                                  SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="Автоматически под тему" Tag="Auto"/>
                            <ComboBoxItem Content="Нейтральные" Tag="Neutral"/>
                            <ComboBoxItem Content="В цвет темы" Tag="Accent"/>
                        </ComboBox>


                        <Button Content="Сбросить настройки"
                                Style="{StaticResource AppSecondaryButton}"
                                Margin="0,26,0,0"
                                Click="Reset_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>


            <!-- Правая карточка: предпросмотр -->
            <Border Grid.Column="1"
                    Margin="18,0,0,0"
                    Style="{StaticResource SettingsCard}">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock Text="Предпросмотр"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="Так будут выглядеть окна и кнопки программы."
                                   Margin="0,6,0,18"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>


                        <Border CornerRadius="18"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="18">

                            <StackPanel>

                                <TextBlock Text="Кузница шрифтов"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="Создание собственного шрифта из почерка"
                                           Margin="0,6,0,18"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>


                                <Border CornerRadius="14"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource MutedBorderBrush}"
                                        BorderThickness="1"
                                        Padding="14"
                                        Margin="0,0,0,16">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Пример шрифта"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>

                                            <TextBlock Text="Создан: сегодня"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="✏️"
                                                   FontSize="18"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Grid>
                                </Border>


                                <Button Content="Основная кнопка"
                                        Style="{StaticResource PreviewButton}"
                                        HorizontalAlignment="Left"/>

                                <Button Content="Вторичная кнопка"
                                        Style="{StaticResource AppSecondaryButton}"
                                        Width="180"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"/>

                                <Button Content="Опасная кнопка"
                                        Style="{StaticResource AppDangerButton}"
                                        Width="170"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"/>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>


        <!-- Нижняя панель -->
        <Grid Grid.Row="2"
              Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Настройки применяются сразу и сохраняются автоматически."
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12"/>

            <Button Grid.Column="1"
                    Content="Закрыть"
                    Style="{StaticResource AppPrimaryButton}"
                    Width="150"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>