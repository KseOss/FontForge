<Window x:Class="FontForge.ThemeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки оформления"
        Width="840"
        Height="700"
        MinWidth="840"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Logo.png"
        Loaded="Window_Loaded">

    <Window.Resources>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsTabControl" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource MutedBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="6"
                                    HorizontalAlignment="Left">

                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"/>
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              Margin="0,16,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabItem" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Pill"
                                CornerRadius="14"
                                Padding="18,9"
                                Margin="3,0"
                                Background="Transparent">

                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="21"
                                Background="{TemplateBinding Background}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Настройки"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>

            <TextBlock Text="Оформление и поведение программы."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <!-- Вкладки -->
        <TabControl Grid.Row="1"
                    Margin="0,22,0,0"
                    Style="{StaticResource SettingsTabControl}"
                    ItemContainerStyle="{StaticResource SettingsTabItem}">

            <!-- Вкладка Оформление -->
            <TabItem Header="Оформление">
                <Border Style="{StaticResource SettingsCard}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,18,0">

                                <TextBlock Text="Тема"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="Выберите светлый или тёмный режим."
                                           Margin="0,4,0,8"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <ComboBox x:Name="ThemeModeCombo"
                                          Style="{StaticResource AppComboBox}"
                                          SelectionChanged="Settings_Changed">
                                    <ComboBoxItem Content="Светлая" Tag="Light"/>
                                    <ComboBoxItem Content="Тёмная" Tag="Dark"/>
                                </ComboBox>

                                <TextBlock Text="Цветовая тема"
                                           Margin="0,22,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="Основной оттенок интерфейса."
                                           Margin="0,4,0,8"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <ComboBox x:Name="AccentCombo"
                                          Style="{StaticResource AppComboBox}"
                                          SelectionChanged="Settings_Changed">
                                    <ComboBoxItem Content="Серая" Tag="Neutral"/>
                                    <ComboBoxItem Content="Голубая" Tag="Blue"/>
                                    <ComboBoxItem Content="Зелёная" Tag="Green"/>
                                    <ComboBoxItem Content="Фиолетовая" Tag="Purple"/>
                                    <ComboBoxItem Content="Розовая" Tag="Rose"/>
                                    <ComboBoxItem Content="Оранжевая" Tag="Orange"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="18,0,0,0">

                                <TextBlock Text="Фон окна"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="Обычный фон или мягкий градиент."
                                           Margin="0,4,0,8"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <ComboBox x:Name="BackgroundCombo"
                                          Style="{StaticResource AppComboBox}"
                                          SelectionChanged="Settings_Changed">
                                    <ComboBoxItem Content="Обычный цвет" Tag="Plain"/>
                                    <ComboBoxItem Content="Мягкий градиент" Tag="SoftGradient"/>
                                    <ComboBoxItem Content="Выраженный градиент" Tag="StrongGradient"/>
                                </ComboBox>

                                <TextBlock Text="Кнопки"
                                           Margin="0,22,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="Кнопки могут быть нейтральными или цветными."
                                           Margin="0,4,0,8"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <ComboBox x:Name="ButtonStyleCombo"
                                          Style="{StaticResource AppComboBox}"
                                          SelectionChanged="Settings_Changed">
                                    <ComboBoxItem Content="Автоматически под тему" Tag="Auto"/>
                                    <ComboBoxItem Content="Нейтральные" Tag="Neutral"/>
                                    <ComboBoxItem Content="В цвет темы" Tag="Accent"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Вкладка Поведение -->
            <TabItem Header="Поведение">
                <Border Style="{StaticResource SettingsCard}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,18,0">

                                <TextBlock Text="После загрузки открывать"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="Можно сразу открывать список созданных шрифтов."
                                           Margin="0,4,0,8"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <ComboBox x:Name="StartWindowCombo"
                                          Style="{StaticResource AppComboBox}"
                                          SelectionChanged="Settings_Changed">
                                    <ComboBoxItem Content="Главное меню" Tag="MainWindow"/>
                                    <ComboBoxItem Content="Мои шрифты" Tag="FontsWindow"/>
                                </ComboBox>

                                <TextBlock Text="После создания шрифта"
                                           Margin="0,22,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="Выберите, открывать ли редактор сразу."
                                           Margin="0,4,0,8"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <ComboBox x:Name="AfterCreateFontCombo"
                                          Style="{StaticResource AppComboBox}"
                                          SelectionChanged="Settings_Changed">
                                    <ComboBoxItem Content="Сразу открыть редактор" Tag="OpenEditor"/>
                                    <ComboBoxItem Content="Остаться в списке" Tag="StayInList"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="18,0,0,0">

                                <TextBlock Text="Подтверждение корзины"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="Спрашивать подтверждение перед перемещением шрифта в корзину."
                                           Margin="0,4,0,8"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <ComboBox x:Name="ConfirmMoveToTrashCombo"
                                          Style="{StaticResource AppComboBox}"
                                          SelectionChanged="Settings_Changed">
                                    <ComboBoxItem Content="Спрашивать перед корзиной" Tag="True"/>
                                    <ComboBoxItem Content="Перемещать сразу" Tag="False"/>
                                </ComboBox>

                                <Border Margin="0,26,0,0"
                                        CornerRadius="16"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource MutedBorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">

                                    <StackPanel>
                                        <TextBlock Text="Подсказка"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>

                                        <TextBlock Text="Эти параметры не меняют данные шрифтов, а только делают работу с программой удобнее."
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Вкладка Предпросмотр -->
            <TabItem Header="Предпросмотр">
                <Border Style="{StaticResource SettingsCard}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    CornerRadius="20"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="24">

                                <StackPanel>
                                    <TextBlock Text="Кузница шрифтов"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>

                                    <TextBlock Text="Создание собственного шрифта из почерка"
                                               Margin="0,6,0,20"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <Border CornerRadius="16"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource MutedBorderBrush}"
                                            BorderThickness="1"
                                            Padding="16"
                                            Margin="0,0,0,16">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Пример шрифта"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>

                                                <TextBlock Text="Создан: сегодня"
                                                           Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="✏️"
                                                       FontSize="20"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>
                                    </Border>

                                    <WrapPanel>
                                        <Button Content="Основная кнопка"
                                                Style="{StaticResource PreviewButton}"
                                                Margin="0,0,10,10"/>

                                        <Button Content="Вторичная"
                                                Style="{StaticResource AppSecondaryButton}"
                                                Width="140"
                                                Margin="0,0,10,10"/>

                                        <Button Content="Опасная"
                                                Style="{StaticResource AppDangerButton}"
                                                Width="130"
                                                Margin="0,0,10,10"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="18,0,0,0"
                                    CornerRadius="20"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="18">

                                <StackPanel>
                                    <TextBlock Text="Что меняется?"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>

                                    <TextBlock Text="• фон окон"
                                               Margin="0,14,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock Text="• цвет кнопок"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock Text="• цвет выделения"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock Text="• общий стиль интерфейса"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>

        <!-- Нижняя панель -->
        <Grid Grid.Row="2"
              Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Настройки применяются сразу и сохраняются автоматически."
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12"/>

            <Button Grid.Column="1"
                    Content="Сбросить"
                    Style="{StaticResource AppSecondaryButton}"
                    Width="130"
                    Margin="0,0,10,0"
                    Click="Reset_Click"/>

            <Button Grid.Column="2"
                    Content="Закрыть"
                    Style="{StaticResource AppPrimaryButton}"
                    Width="140"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>