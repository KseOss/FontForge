<Window x:Class="FontForge.DocumentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор текста"
        Height="800"
        Width="1240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Logo.png"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- Фон листа в клетку.
             Это только предпросмотр, в PDF сетка не сохраняется. -->
        <DrawingBrush x:Key="PaperGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,96,96"
                      ViewportUnits="Absolute"
                      Stretch="None">

            <DrawingBrush.Drawing>
                <DrawingGroup>

                    <!-- Белый фон листа -->
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,96,96"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- Маленькие клетки -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#E8EDF5" Thickness="0.8"/>
                        </GeometryDrawing.Pen>

                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="24,0" EndPoint="24,96"/>
                                <LineGeometry StartPoint="48,0" EndPoint="48,96"/>
                                <LineGeometry StartPoint="72,0" EndPoint="72,96"/>

                                <LineGeometry StartPoint="0,24" EndPoint="96,24"/>
                                <LineGeometry StartPoint="0,48" EndPoint="96,48"/>
                                <LineGeometry StartPoint="0,72" EndPoint="96,72"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- Более заметные большие клетки -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#D7E0EF" Thickness="1.1"/>
                        </GeometryDrawing.Pen>

                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="0,96"/>
                                <LineGeometry StartPoint="96,0" EndPoint="96,96"/>

                                <LineGeometry StartPoint="0,0" EndPoint="96,0"/>
                                <LineGeometry StartPoint="0,96" EndPoint="96,96"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Border Style="{StaticResource AppCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактор текста"
                               Style="{StaticResource AppTitleText}"/>

                    <TextBlock Margin="0,12,0,6"
                               Text="Шрифт"
                               Style="{StaticResource AppLabelText}"/>

                    <ComboBox x:Name="FontsCombo"
                              Style="{StaticResource AppComboBox}"
                              SelectionChanged="FontsCombo_SelectionChanged"/>

                    <TextBlock Margin="0,14,0,6"
                               Text="Текст"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBox x:Name="InputBox"
                             Style="{StaticResource AppTextBox}"
                             Height="150"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="InputBox_TextChanged"
                             Text="Введите свой текст и сохраните в PDF."/>

                    <TextBlock Margin="0,14,0,0"
                               Text="Размер текста"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBlock x:Name="PreviewSizeValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource AppLabelText}"/>

                    <Slider x:Name="PreviewSizeSlider"
                            Style="{StaticResource AppSlider}"
                            Minimum="18"
                            Maximum="140"
                            Value="64"
                            ValueChanged="TypographySettings_Changed"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Межбуквенный интервал"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBlock x:Name="LetterSpacingValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource AppLabelText}"/>

                    <Slider x:Name="LetterSpacingSlider"
                            Style="{StaticResource AppSlider}"
                            Minimum="-20"
                            Maximum="35"
                            Value="0"
                            TickFrequency="1"
                            ValueChanged="TypographySettings_Changed"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Расстояние между словами"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBlock x:Name="WordSpacingValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource AppLabelText}"/>

                    <Slider x:Name="WordSpacingSlider"
                            Style="{StaticResource AppSlider}"
                            Minimum="10"
                            Maximum="120"
                            Value="32"
                            ValueChanged="TypographySettings_Changed"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Межстрочный интервал"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBlock x:Name="LineSpacingValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource AppLabelText}"/>

                    <Slider x:Name="LineSpacingSlider"
                            Style="{StaticResource AppSlider}"
                            Minimum="0.8"
                            Maximum="3.0"
                            Value="1.2"
                            TickFrequency="0.1"
                            ValueChanged="TypographySettings_Changed"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Отступ слева"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBlock x:Name="LeftIndentValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource AppLabelText}"/>

                    <Slider x:Name="LeftIndentSlider"
                            Style="{StaticResource AppSlider}"
                            Minimum="0"
                            Maximum="180"
                            Value="0"
                            ValueChanged="TypographySettings_Changed"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Отступ первой строки каждого абзаца"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBlock x:Name="FirstLineIndentValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource AppLabelText}"/>

                    <Slider x:Name="FirstLineIndentSlider"
                            Style="{StaticResource AppSlider}"
                            Minimum="0"
                            Maximum="180"
                            Value="0"
                            ValueChanged="TypographySettings_Changed"/>

                    <Button Margin="0,18,0,0"
                            Style="{StaticResource AppPrimaryButton}"
                            Content="Сохранить в PDF"
                            Click="SavePdf_Click"/>

                    <Button Margin="0,10,0,0"
                            Style="{StaticResource AppSecondaryButton}"
                            Content="Закрыть"
                            Click="Close_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Правая область предпросмотра -->
        <Border Grid.Column="1"
                Margin="18,0,0,0"
                CornerRadius="18"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">

            <Grid Margin="16">

                <!-- Лист с клетками -->
                <Border CornerRadius="14"
                        Background="{StaticResource PaperGridBrush}"
                        BorderBrush="#D6DAE2"
                        BorderThickness="1">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent">

                        <StackPanel x:Name="PreviewRoot"
                                    Margin="24"/>
                    </ScrollViewer>
                </Border>

                <!-- Маленькая подпись -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,10,10,0"
                        Padding="10,5"
                        CornerRadius="12"
                        Background="#CCFFFFFF"
                        BorderBrush="#D6DAE2"
                        BorderThickness="1">

                    <TextBlock Text="Предпросмотр страницы"
                               FontSize="12"
                               Foreground="#667085"/>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>