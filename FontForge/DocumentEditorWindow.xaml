<Window x:Class="FontForge.DocumentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор текста"
        Height="800"
        Width="1240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Untitled.png"
        Loaded="Window_Loaded">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource AppCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактор текста"
                               Style="{StaticResource AppTitleText}"/>

                    <TextBlock Margin="0,12,0,6"
                               Text="Шрифт"
                               Style="{StaticResource AppLabelText}"/>

                    <ComboBox x:Name="FontsCombo"
                        Style="{StaticResource AppComboBox}"
                        SelectionChanged="FontsCombo_SelectionChanged"/>

                    <TextBlock Margin="0,14,0,6"
                               Text="Текст"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBox x:Name="InputBox"
                             Style="{StaticResource AppTextBox}"
                             Height="150"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="InputBox_TextChanged"
                             Text="Введите свой текст и сохраните в PDF."/>

                    <TextBlock Margin="0,14,0,0"
                               Text="Размер текста"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBlock x:Name="PreviewSizeValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource AppLabelText}"/>

                    <Slider x:Name="PreviewSizeSlider"
                        Style="{StaticResource AppSlider}"
                        Minimum="18"
                        Maximum="140"
                        Value="64"
                        ValueChanged="TypographySettings_Changed"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Межбуквенный интервал"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBlock x:Name="LetterSpacingValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource AppLabelText}"/>

                    <Slider x:Name="LetterSpacingSlider"
                            Style="{StaticResource AppSlider}"
                            Minimum="-20"
                            Maximum="35"
                            Value="0"
                            TickFrequency="1"
                            ValueChanged="TypographySettings_Changed"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Расстояние между словами"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBlock x:Name="WordSpacingValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource AppLabelText}"/>

                    <Slider x:Name="WordSpacingSlider"
                            Style="{StaticResource AppSlider}"
                            Minimum="10"
                            Maximum="120"
                            Value="32"
                            ValueChanged="TypographySettings_Changed"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Межстрочный интервал"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBlock x:Name="LineSpacingValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource AppLabelText}"/>

                    <Slider x:Name="LineSpacingSlider"
                            Style="{StaticResource AppSlider}"
                            Minimum="0.8"
                            Maximum="3.0"
                            Value="1.2"
                            TickFrequency="0.1"
                            ValueChanged="TypographySettings_Changed"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Отступ слева"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBlock x:Name="LeftIndentValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource AppLabelText}"/>

                    <Slider x:Name="LeftIndentSlider"
                            Style="{StaticResource AppSlider}"
                            Minimum="0"
                            Maximum="180"
                            Value="0"
                            ValueChanged="TypographySettings_Changed"/>

                    <TextBlock Margin="0,12,0,0"
                               Text="Отступ первой строки каждого абзаца"
                               Style="{StaticResource AppLabelText}"/>

                    <TextBlock x:Name="FirstLineIndentValueText"
                               Margin="0,2,0,0"
                               Style="{StaticResource AppLabelText}"/>

                    <Slider x:Name="FirstLineIndentSlider"
                            Style="{StaticResource AppSlider}"
                            Minimum="0"
                            Maximum="180"
                            Value="0"
                            ValueChanged="TypographySettings_Changed"/>

                    <Button Margin="0,18,0,0"
                            Style="{StaticResource AppPrimaryButton}"
                            Content="Сохранить в PDF"
                            Click="SavePdf_Click"/>

                    <Button Margin="0,10,0,0"
                            Style="{StaticResource AppSecondaryButton}"
                            Content="Закрыть"
                            Click="Close_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1"
                Margin="18,0,0,0"
                Style="{StaticResource AppPreviewPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PreviewRoot" Margin="18"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>