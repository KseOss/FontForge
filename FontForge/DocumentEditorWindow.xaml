<Window x:Class="FontForge.DocumentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор текста"
        Height="760" Width="1200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Untitled.png"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="#0D000000"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="22" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NiceSlider" TargetType="Slider">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="34">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton IsHitTestVisible="False" Focusable="False" BorderThickness="0" Background="Transparent">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="3"
                                                        Background="{DynamicResource ButtonBackgroundBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton IsHitTestVisible="False" Focusable="False" BorderThickness="0" Background="Transparent">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="3"
                                                        Background="#18000000"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="9"
                                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                                        BorderBrush="#22FFFFFF"
                                                        BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Редактор текста"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Margin="0,10,0,6"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Шрифт"/>

                <ComboBox x:Name="FontsCombo"
                          Height="36"
                          Background="#0A000000"
                          Foreground="{DynamicResource TextBrush}"
                          BorderThickness="0"
                          Padding="10,0"
                          SelectionChanged="FontsCombo_SelectionChanged"/>

                <TextBlock Margin="0,14,0,6"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Размер предпросмотра"/>

                <Slider x:Name="PreviewSizeSlider"
                        Style="{StaticResource NiceSlider}"
                        Minimum="18"
                        Maximum="140"
                        Value="64"
                        ValueChanged="PreviewSizeSlider_ValueChanged"/>

                <TextBlock Margin="0,14,0,6"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Текст"/>

                <TextBox x:Name="InputBox"
                         Height="240"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="#0A000000"
                         Foreground="{DynamicResource TextBrush}"
                         BorderThickness="0"
                         Padding="12"
                         TextChanged="InputBox_TextChanged"
                         FontSize="14"
                         Text="Пример: АБВГДЕ ЁЖЗИЙКЛМНОП РСТУФХЦЧШЩЪЫЬЭЮЯ&#10;Введите свой текст и сохраните в PDF."/>

                <Button Margin="0,14,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="Сохранить в PDF"
                        Click="SavePdf_Click"/>

                <Button Margin="0,10,0,0"
                        Height="44"
                        Content="Закрыть"
                        Click="Close_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Margin="18,0,0,0"
                CornerRadius="18"
                Background="White"
                BorderBrush="#22000000"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PreviewRoot" Margin="18"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
