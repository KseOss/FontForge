<Application x:Class="FontForge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ====== Светлая тема ====== -->
        <SolidColorBrush x:Key="LightBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LightTextBrush" Color="#111111"/>
        <SolidColorBrush x:Key="LightSecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="LightButtonBackgroundBrush" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="LightButtonTextBrush" Color="#FFFFFF"/>

        <!-- ====== Тёмная тема ====== -->
        <SolidColorBrush x:Key="DarkBackgroundBrush" Color="#0F1115"/>
        <SolidColorBrush x:Key="DarkTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DarkSecondaryTextBrush" Color="#B3B3B3"/>
        <SolidColorBrush x:Key="DarkButtonBackgroundBrush" Color="#2D8CFF"/>
        <SolidColorBrush x:Key="DarkButtonTextBrush" Color="#FFFFFF"/>

        <!-- ====== Текущие кисти (DynamicResource) ====== -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#111111"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>

    </Application.Resources>
</Application>
