<Window x:Class="FontForge.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка"
        Width="680"
        Height="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Border x:Name="RootCard"
            CornerRadius="30"
            Background="#F7F8FB"
            BorderBrush="#D6DAE2"
            BorderThickness="1"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">

        <Border.Effect>
            <DropShadowEffect BlurRadius="35"
                              ShadowDepth="0"
                              Opacity="0.20"
                              Color="#000000"/>
        </Border.Effect>

        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>

        <Grid Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Логотип -->
            <Border Grid.Row="1"
                    Width="170"
                    Height="170"
                    CornerRadius="42"
                    Background="#EDF1F7"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center"
                    Padding="18">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="22"
                                      ShadowDepth="0"
                                      Opacity="0.18"
                                      Color="#000000"/>
                </Border.Effect>

                <Image Source="/Images/Logo.png"
                       Stretch="Uniform"
                       Opacity="1"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="0"
                                          Opacity="0.22"
                                          Color="#475569"/>
                    </Image.Effect>
                </Image>
            </Border>

            <!-- Название -->
            <TextBlock Grid.Row="2"
                       Text="Кузница шрифтов"
                       Margin="0,28,0,0"
                       HorizontalAlignment="Center"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="#101114"/>

            <!-- Подзаголовок -->
            <TextBlock Grid.Row="3"
                       Text="Подготовка рабочей среды для создания шрифта"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="#667085"/>

            <!-- Загрузка -->
            <StackPanel Grid.Row="4"
                        Margin="0,30,0,0"
                        HorizontalAlignment="Center">

                <!-- Полоска прогресса -->
                <Border Width="270"
                        Height="8"
                        CornerRadius="4"
                        Background="#E4E7EC"
                        ClipToBounds="True">

                    <Grid>
                        <Border x:Name="ProgressFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                CornerRadius="4"
                                Background="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="LoadingText"
                           Text="Сбор данных приложения..."
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="#667085"/>

                <TextBlock x:Name="LoadingDetailText"
                           Text="Подготовка ресурсов"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="#98A2B3"/>

                <TextBlock x:Name="LoadingPercentText"
                           Text="0%"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#101114"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>