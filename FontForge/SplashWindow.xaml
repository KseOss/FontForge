<Window x:Class="FontForge.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка"
        Width="680"
        Height="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Border x:Name="RootCard"
            CornerRadius="30"
            Background="{DynamicResource BackgroundBrush}"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5"
            ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="35"
                              ShadowDepth="0"
                              Opacity="0.22"
                              Color="#000000"/>
        </Border.Effect>

        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>

        <Grid>

            <!-- Базовый мягкий фон -->
            <Rectangle Fill="{DynamicResource BackgroundBrush}"/>

            <!-- Мягкое большое пятно 1 -->
            <Ellipse x:Name="GlowOne"
                     Width="360"
                     Height="360"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-120,-150,0,0"
                     Opacity="0.28"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowOneColor" Color="#D1D5DB" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>

                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="GlowOneTransform" X="0" Y="0"/>
                </Ellipse.RenderTransform>

                <Ellipse.Effect>
                    <BlurEffect Radius="28"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Мягкое большое пятно 2 -->
            <Ellipse x:Name="GlowTwo"
                     Width="420"
                     Height="420"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-160,-180"
                     Opacity="0.24"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowTwoColor" Color="#D1D5DB" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>

                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="GlowTwoTransform" X="0" Y="0"/>
                </Ellipse.RenderTransform>

                <Ellipse.Effect>
                    <BlurEffect Radius="34"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Светлое центральное стекло -->
            <Border Margin="0"
                    CornerRadius="30"
                    Background="#22FFFFFF"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="1"/>

            <Grid Margin="36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <Border Grid.Row="1"
                        Width="170"
                        Height="170"
                        CornerRadius="42"
                        Background="#EDF1F7"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center"
                        Padding="18">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.18"
                                          Color="#000000"/>
                    </Border.Effect>

                    <Image Source="/Images/Logo.png"
                           Stretch="Uniform"
                           Opacity="1"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.24"
                                              Color="#475569"/>
                        </Image.Effect>
                    </Image>
                </Border>

                <!-- Название -->
                <TextBlock Grid.Row="2"
                           Text="Кузница шрифтов"
                           Margin="0,28,0,0"
                           HorizontalAlignment="Center"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>

                <!-- Подзаголовок -->
                <TextBlock Grid.Row="3"
                           Text="Подготовка рабочей среды для создания шрифта"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <!-- Загрузка -->
                <StackPanel Grid.Row="4"
                            Margin="0,30,0,0"
                            HorizontalAlignment="Center">

                    <Border Width="270"
                            Height="8"
                            CornerRadius="4"
                            Background="{DynamicResource MutedBorderBrush}"
                            ClipToBounds="True">

                        <Grid>
                            <Border x:Name="ProgressFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="4"
                                    Background="{DynamicResource AccentBrush}"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="LoadingText"
                               Text="Сбор данных приложения..."
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock x:Name="LoadingDetailText"
                               Text="Подготовка ресурсов"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Opacity="0.78"/>

                    <TextBlock x:Name="LoadingPercentText"
                               Text="0%"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>