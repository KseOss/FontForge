<Window x:Class="FontForge.TemplateSymbolsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор символов для шаблона"
        Height="700"
        Width="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Logo.png"
        Loaded="Window_Loaded"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style x:Key="DialogCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="GroupTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="8,18,0,8"/>
        </Style>

        <Style x:Key="SymbolCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Root"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                                <Border x:Name="CheckMark"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="8"
                                        Background="{DynamicResource ButtonTextBrush}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,5,5,0"
                                        Visibility="Collapsed">

                                    <TextBlock Text="✓"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ButtonBackgroundBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Opacity="{TemplateBinding Opacity}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border CornerRadius="9"
                                Background="{TemplateBinding Background}">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Margin="4">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThemeScrollThumb}"/>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>

                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Border Style="{StaticResource DialogCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Выберите символы"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Text="Отметьте только те буквы, цифры и знаки, которые есть в PDF-шаблоне."
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13"/>
                </StackPanel>

                <WrapPanel Grid.Row="1"
                           Margin="0,18,0,0">

                    <Button Content="Выбрать всё"
                            Style="{StaticResource AppSecondaryButton}"
                            Width="130"
                            Margin="0,0,10,10"
                            Click="SelectAll_Click"/>

                    <Button Content="Очистить"
                            Style="{StaticResource AppSecondaryButton}"
                            Width="120"
                            Margin="0,0,10,10"
                            Click="ClearAll_Click"/>

                    <Button Content="Русские"
                            Style="{StaticResource AppSecondaryButton}"
                            Width="115"
                            Margin="0,0,10,10"
                            Click="OnlyRussian_Click"/>

                    <Button Content="English"
                            Style="{StaticResource AppSecondaryButton}"
                            Width="115"
                            Margin="0,0,10,10"
                            Click="OnlyEnglish_Click"/>

                    <Button Content="Цифры"
                            Style="{StaticResource AppSecondaryButton}"
                            Width="105"
                            Margin="0,0,10,10"
                            Click="OnlyDigits_Click"/>

                    <Button Content="Символы"
                            Style="{StaticResource AppSecondaryButton}"
                            Width="115"
                            Margin="0,0,10,10"
                            Click="OnlySpecial_Click"/>

                </WrapPanel>

                <Border Grid.Row="2"
                        Style="{StaticResource PanelCard}"
                        Margin="0,10,0,0">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">

                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemeScrollBar}"/>
                        </ScrollViewer.Resources>

                        <StackPanel x:Name="SymbolsHost"/>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="3"
                      Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CountText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13"/>

                    <Button Grid.Column="1"
                            Content="Назад"
                            Style="{StaticResource AppSecondaryButton}"
                            Width="140"
                            Margin="0,0,12,0"
                            Click="Cancel_Click"/>

                    <Button Grid.Column="2"
                            Content="Продолжить"
                            Style="{StaticResource AppPrimaryButton}"
                            Width="160"
                            Click="Ok_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>