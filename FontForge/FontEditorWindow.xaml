<Window x:Class="FontForge.FontEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование шрифта"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Untitled.png"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ===== ToggleSwitch темы (как у тебя) ===== -->
        <Style x:Key="ThemeToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="Track"
                                    CornerRadius="17"
                                    Background="#D6D6D6"
                                    BorderBrush="#B8B8B8"
                                    BorderThickness="1"/>
                            <Border x:Name="Thumb"
                                    Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Border.RenderTransform>
                                <TextBlock x:Name="IconText"
                                           Text="🌙"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2D8CFF"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#2D8CFF"/>
                                <Setter TargetName="IconText" Property="Text" Value="🔆"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="36"
                                                             Duration="0:0:0.18"
                                                             AccelerationRatio="0.2"
                                                             DecelerationRatio="0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.18"
                                                             AccelerationRatio="0.2"
                                                             DecelerationRatio="0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#F3F3F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Кнопка основная ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="23" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Карточка ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="#0D000000"/>
        </Style>

        <!-- ===== Плитка символа ===== -->
        <Style x:Key="GlyphTile" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Background" Value="#0A000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#12000000"
                                BorderThickness="1">
                            <ContentPresenter Margin="10"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1F000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearTextButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFDD4B4B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#B23A3A"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Предпросмотр"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="FontNameText"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <ToggleButton x:Name="ThemeToggleButton"
                          Grid.Column="1"
                          Style="{StaticResource ThemeToggleSwitchStyle}"
                          VerticalAlignment="Top"
                          Click="ThemeToggleButton_Click"/>
        </Grid>

        <!-- ===== Preview ===== -->
        <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Предпросмотр"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="Размер шрифта предпросмотра"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Slider x:Name="PreviewSizeSlider"
                            Minimum="18" Maximum="90" Value="46"
                            ValueChanged="PreviewSizeSlider_ValueChanged"/>
                </StackPanel>

                <!-- Ввод + Очистить -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Введите текст для проверки"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox x:Name="PreviewInput"
                                 Margin="0,8,12,0"
                                 Height="40"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Background="#0A000000"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderThickness="0"
                                 Padding="12,0"
                                 TextChanged="PreviewInput_TextChanged"
                                 Text="АБВГДЕ ЁЖЗИЙКЛМНОП РСТУФХЦЧШЩЪЫЬЭЮЯ"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Очистить текст"
                            Style="{StaticResource ClearTextButtonStyle}"
                            VerticalAlignment="Bottom"
                            Click="ClearText_Click"/>
                </Grid>

                <!-- Рендер предпросмотра -->
                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        CornerRadius="14"
                        Background="#06FFFFFF"
                        BorderBrush="#12000000"
                        BorderThickness="1"
                        Padding="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PreviewRenderPanel"
                                   VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Border>

        <!-- ===== Glyphs ===== -->
        <Border Grid.Row="2" Margin="0,18,0,0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Символы шрифта"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock x:Name="GlyphCountText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Glyphs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GlyphTile}" Click="GlyphTile_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{Binding Char}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>

                                        <Border Grid.Row="1"
                                                Margin="0,8,0,0"
                                                CornerRadius="10"
                                                Background="White"
                                                BorderBrush="#1A000000"
                                                BorderThickness="1">
                                            <Image Source="{Binding DefaultImagePath}"
                                                   Stretch="Uniform"
                                                   Margin="6"/>
                                        </Border>

                                        <TextBlock Text="•"
                                                   FontSize="20"
                                                   Foreground="Red"
                                                   VerticalAlignment="Top"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,10,10,0"
                                                   Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== Bottom buttons ===== -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Назад"
                    Style="{StaticResource PrimaryButton}"
                    Width="140"
                    Click="Back_Click"/>

            <Button Grid.Column="2"
                    Content="+ Нарисовать новый символ"
                    Style="{StaticResource PrimaryButton}"
                    Click="AddGlyph_Click"/>

            <!-- ✅ ВМЕСТО “СОХРАНИТЬ ШРИФТ” -->
            <Button Grid.Column="3"
                    Margin="10,0,0,0"
                    Content="Открыть редактор текста"
                    Style="{StaticResource PrimaryButton}"
                    Click="OpenDocumentEditor_Click"/>
        </Grid>

        <Rectangle x:Name="FadeOverlay"
                   Panel.ZIndex="999"
                   Fill="{DynamicResource BackgroundBrush}"
                   Opacity="0"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
