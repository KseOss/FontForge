<Window x:Class="FontForge.FontEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование шрифта"
        Height="795"
        Width="1120"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Logo.png"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="23"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="8,0"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="17"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallDangerButton" TargetType="Button" BasedOn="{StaticResource SmallActionButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <Style x:Key="PrettySlider" TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="32">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center"
                                   Height="18">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Focusable="False"
                                                  BorderThickness="0"
                                                  Background="Transparent">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="3"
                                                        Background="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Focusable="False"
                                                  BorderThickness="0"
                                                  Background="Transparent">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="3"
                                                        Background="{DynamicResource BorderBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="18"
                                           Height="18"
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="Knob"
                                                             Fill="{DynamicResource AccentBrush}"
                                                             Stroke="{DynamicResource SurfaceBrush}"
                                                             StrokeThickness="2"/>

                                                    <Ellipse x:Name="Glow"
                                                             Width="30"
                                                             Height="30"
                                                             Fill="{DynamicResource AccentBrush}"
                                                             Opacity="0"/>
                                                </Grid>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glow" Property="Opacity" Value="0.14"/>
                                                    </Trigger>

                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Glow" Property="Opacity" Value="0.22"/>
                                                        <Setter TargetName="Knob" Property="StrokeThickness" Value="3"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlyphScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Root"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Opacity="{TemplateBinding Opacity}"/>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlyphScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border CornerRadius="9"
                                Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Margin="4">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GlyphScrollThumb}"/>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlyphTileCard" TargetType="Border">
            <Setter Property="Width" Value="132"/>
            <Setter Property="Height" Value="166"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GlyphDeleteButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileMiniButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="8,0"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Предпросмотр"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>

                <TextBlock x:Name="FontNameText"
                           Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Предпросмотр -->
        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Предпросмотр"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>

                <StackPanel Grid.Row="1"
                            Margin="0,12,0,0">
                    <TextBlock Text="Размер шрифта предпросмотра"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <Slider x:Name="PreviewSizeSlider"
                            Style="{StaticResource PrettySlider}"
                            Minimum="18"
                            Maximum="90"
                            Value="46"
                            ValueChanged="PreviewSizeSlider_ValueChanged"/>
                </StackPanel>

                <Grid Grid.Row="2"
                      Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Введите текст для проверки"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <TextBox x:Name="PreviewInput"
                                 Margin="0,8,12,0"
                                 Height="40"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 BorderBrush="{DynamicResource MutedBorderBrush}"
                                 BorderThickness="1"
                                 Padding="12,0"
                                 TextChanged="PreviewInput_TextChanged"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Очистить текст"
                            Style="{StaticResource DangerButton}"
                            VerticalAlignment="Bottom"
                            Click="ClearText_Click"/>
                </Grid>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        CornerRadius="14"
                        Background="#F3F4EF"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PreviewRenderPanel"
                                   VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Символы шрифта -->
        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Символы шрифта"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock x:Name="SelectedGlyphCountText"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Выбрать всё"
                            Style="{StaticResource SmallActionButton}"
                            Margin="0,0,8,0"
                            Click="SelectAllGlyphs_Click"/>

                    <Button x:Name="ClearSelectionButton"
                            Grid.Column="3"
                            Content="Снять выбор"
                            Style="{StaticResource SmallActionButton}"
                            Margin="0,0,8,0"
                            Click="ClearGlyphSelection_Click"/>

                    <Button x:Name="DeleteSelectedButton"
                            Grid.Column="4"
                            Content="Удалить выбранные"
                            Style="{StaticResource SmallDangerButton}"
                            Width="150"
                            Margin="0,0,14,0"
                            Click="DeleteSelectedGlyphs_Click"/>

                    <TextBlock x:Name="GlyphCountText"
                               Grid.Column="5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource GlyphScrollBar}"/>
                    </ScrollViewer.Resources>

                    <ItemsControl ItemsSource="{Binding Glyphs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlyphTileCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,7,0"
                                                      Click="GlyphCheckBox_Click"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Char}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="•"
                                                       FontSize="24"
                                                       FontWeight="Black"
                                                       Foreground="Red"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"
                                                       Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <Button Grid.Column="4"
                                                    Style="{StaticResource GlyphDeleteButton}"
                                                    ToolTip="Удалить символ"
                                                    Click="DeleteGlyph_Click">
                                                <TextBlock Text="&#xE74D;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                        <Border Grid.Row="1"
                                                Margin="0,8,0,8"
                                                CornerRadius="10"
                                                Background="#F3F4EF"
                                                BorderBrush="#1A000000"
                                                BorderThickness="1">
                                            <Image Source="{Binding DefaultImagePath}"
                                                   Stretch="Uniform"
                                                   Margin="6"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <Button Grid.Row="2"
                                                Content="Редактировать"
                                                Style="{StaticResource TileMiniButton}"
                                                Click="EditGlyphFromTile_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Нижние кнопки -->
        <Grid Grid.Row="3"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Назад"
                    Style="{StaticResource PrimaryButton}"
                    Width="130"
                    Click="Back_Click"/>

            <Button Grid.Column="2"
                    Content="PDF-шаблон"
                    ToolTip="Создать PDF-шаблон для печати"
                    Style="{StaticResource PrimaryButton}"
                    Width="135"
                    Click="CreateTemplatePdf_Click"/>

            <Button Grid.Column="3"
                    Margin="10,0,0,0"
                    Content="Загрузить PDF"
                    ToolTip="Загрузить заполненный PDF-шаблон"
                    Style="{StaticResource PrimaryButton}"
                    Width="145"
                    Click="ImportTemplatePdf_Click"/>

            <Button Grid.Column="4"
                    Margin="10,0,0,0"
                    Content="Новый символ"
                    ToolTip="Нарисовать новый символ"
                    Style="{StaticResource PrimaryButton}"
                    Width="135"
                    Click="AddGlyph_Click"/>

            <Button Grid.Column="5"
                    Margin="10,0,0,0"
                    Content="Экспорт TTF/OTF"
                    ToolTip="Сохранить шрифт в TTF или OTF"
                    Style="{StaticResource PrimaryButton}"
                    Width="150"
                    Click="ExportFontFile_Click"/>

            <Button Grid.Column="6"
                    Margin="10,0,0,0"
                    Content="Редактор текста"
                    ToolTip="Открыть редактор текста и PDF"
                    Style="{StaticResource PrimaryButton}"
                    Width="145"
                    Click="OpenDocumentEditor_Click"/>
        </Grid>

        <Rectangle x:Name="FadeOverlay"
                   Panel.ZIndex="999"
                   Fill="{DynamicResource BackgroundBrush}"
                   Opacity="0"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>