<Window x:Class="FontForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Кузница шрифтов"
        Height="313"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Logo.png">

    <Window.Resources>

        <!-- ToggleSwitch (луна/солнце) -->
        <Style x:Key="ThemeToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <!-- Дорожка -->
                            <Border x:Name="Track"
                                    CornerRadius="17"
                                    Background="#D6D6D6"
                                    BorderBrush="#B8B8B8"
                                    BorderThickness="1"/>

                            <!-- Ползунок -->
                            <Border x:Name="Thumb"
                                    Width="30" Height="30"
                                    CornerRadius="15"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Border.RenderTransform>

                                <!-- Иконка -->
                                <TextBlock x:Name="IconText"
                                           Text="🌙"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <!-- Включено: светлая тема, солнце справа -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="IconText" Property="Text" Value="🔆"/>

                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="36"
                                                             Duration="0:0:0.18"
                                                             AccelerationRatio="0.2"
                                                             DecelerationRatio="0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.18"
                                                             AccelerationRatio="0.2"
                                                             DecelerationRatio="0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Hover лёгкий -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#F3F3F3"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.6"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.6"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">

        <!-- ToggleSwitch сверху справа -->
        <ToggleButton x:Name="ThemeToggleButton"
                      Style="{StaticResource ThemeToggleSwitchStyle}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,14,14,0"
                      Click="ThemeToggleButton_Click"/>

        <!-- Ваш контент -->
        <Label Content="СОЗДАЙ СВОЙ СОБСТВЕННЫЙ ШРИФТ"
               HorizontalAlignment="Center"
               Margin="0,84,0,170"
               FontSize="26"
               Foreground="{DynamicResource TextBrush}"/>

        <Label Content="ИЗ СВОЕГО ПОЧЕРКА"
               HorizontalAlignment="Center"
               Margin="0,110,0,140"
               FontSize="26"
               Foreground="{DynamicResource TextBrush}"/>

        <Label Content="Из руки — в цифру, из мысли — в шрифт"
               HorizontalAlignment="Center"
               Margin="0,168,0,97"
               FontSize="15"
               Foreground="{DynamicResource SecondaryTextBrush}"/>

        <Button x:Name="CreateFontButton"
                Content="СОЗДАТЬ СВОЙ ШРИФТ"
                Background="{DynamicResource ButtonBackgroundBrush}"
                Foreground="{DynamicResource ButtonTextBrush}"
                FontSize="15"
                BorderThickness="0"
                Margin="388,218,388,32"
                Cursor="Hand"
                Click="CreateFontButton_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="25"/>
                </Style>
            </Button.Resources>
        </Button>

        <Button x:Name="AboutButton"
                Content="о программе"
                Width="120"
                Height="35"
                Background="Transparent"
                Foreground="{DynamicResource TextBrush}"
                FontSize="14"
                BorderThickness="0"
                Margin="450,265,430,-3"
                Cursor="Hand"
                Click="AboutButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <TextBlock Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"
                               TextDecorations="Underline"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Image Margin="155,71,136,157" Source="/Images/1 слой.png" Stretch="Fill"/>
        <Image Margin="311,97,311,127" Source="/Images/Group 1.png" Stretch="Fill"/>

        <!-- СЛОЙ ДЛЯ ПЛАВНОЙ СМЕНЫ ТЕМЫ (это и есть "анимация темы") -->
        <Rectangle x:Name="FadeOverlay"
                   Panel.ZIndex="999"
                   Fill="{DynamicResource BackgroundBrush}"
                   Opacity="0"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
