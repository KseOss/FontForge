<Window x:Class="FontForge.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщение"
        Width="480"
        Height="260"
        MinWidth="480"
        MinHeight="260"
        MaxWidth="480"
        MaxHeight="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Images/Logo.png"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style x:Key="DialogCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DialogIconBox" TargetType="Border">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource AppSecondaryButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource AppDangerButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Border Style="{StaticResource DialogCard}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBox"
                            Style="{StaticResource DialogIconBox}"
                            VerticalAlignment="Top">

                        <TextBlock x:Name="IconText"
                                   Text="?"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Top">

                        <TextBlock x:Name="TitleText"
                                   Text="Подтверждение"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="MessageText"
                                   Text="Текст сообщения"
                                   Margin="0,10,0,0"
                                   FontSize="14"
                                   LineHeight="21"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,22,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton"
                            Grid.Column="1"
                            Content="Отмена"
                            Style="{StaticResource DialogSecondaryButton}"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"
                            Visibility="Collapsed"/>

                    <Button x:Name="NoButton"
                            Grid.Column="2"
                            Content="Нет"
                            Style="{StaticResource DialogSecondaryButton}"
                            Margin="0,0,10,0"
                            Click="NoButton_Click"
                            Visibility="Collapsed"/>

                    <Button x:Name="OkButton"
                            Grid.Column="3"
                            Content="ОК"
                            Style="{StaticResource DialogPrimaryButton}"
                            Click="OkButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>